API_PORT=3001
API_HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Node automatically loads this file with npm run api after you copy it to api/.env.
# These values MUST stay on the server. Never prefix them with VITE_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional absolute path to a persistent SQLite file (one API process).
# API_STORE_PATH=
# Set NODE_ENV=production and APP_ORIGIN=https://your-domain for production HTTPS.
